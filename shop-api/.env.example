# Copy this file to .env and adjust the values: cp .env.example .env
# .env is gitignored. Never commit real secrets.

NODE_ENV=development
PORT=3001

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA  (matches docker-compose.yml)
DATABASE_URL="postgresql://shop:shop@localhost:5433/shop?schema=public"

# At least 32 characters. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=15m

# Comma-separated list of frontends allowed to call the API
CORS_ORIGIN=http://localhost:5173
